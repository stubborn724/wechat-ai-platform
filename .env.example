# Server
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
ENVIRONMENT=development

# MySQL - 业务数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=wechat_platform

# PostgreSQL - 向量数据库
PG_HOST=localhost
PG_PORT=5432
PG_USER=wechat
PG_PASSWORD=wechat123
PG_DATABASE=wechat_vector

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Credential Encryption
CREDENTIAL_KEY=change-this-to-a-32-char-key!!

# WeChat API Gateway
# direct = backend calls WeChat official API directly and needs IP whitelist
# relay = backend calls the fixed-IP relay service; ordinary users do not need whitelist access
WECHAT_API_CHANNEL=relay
WECHAT_RELAY_BASE_URL=http://8.166.141.59:21111
WECHAT_RELAY_APP_ID=relay_client
WECHAT_RELAY_SECRET=replace-with-relay-secret

# ERP 产品素材源。只在后端 .env 配置，禁止写入前端或提交真实密钥。
# 本地联调使用对方提供的联调地址；生产环境替换为 HTTPS 基础地址。
ERP_PRODUCT_API_BASE_URL=http://xiuman.top:48080
ERP_PRODUCT_TENANT_ID=1
# 按品牌维护来源键、ERP 应用凭证和产品查询路径。client_secret 必须由环境变量或密钥管理服务注入。
ERP_PRODUCT_SOURCES_JSON=[]

# DashScope AI (LLM)
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=qwen-plus

# 文生文使用双 Kuai 模型。真实密钥只写入本地 .env。
TEXT_GENERATION_PROVIDER_CHAIN=kuai,kuai_secondary
TEXT_GENERATION_BASE_URL=https://your-text-relay.example.com/v1
TEXT_GENERATION_API_KEY=
TEXT_GENERATION_MODEL=gpt-5-mini
TEXT_GENERATION_SECONDARY_BASE_URL=https://your-text-relay.example.com/v1
TEXT_GENERATION_SECONDARY_API_KEY=
TEXT_GENERATION_SECONDARY_MODEL=qwen3.5-flash
TEXT_GENERATION_TIMEOUT_SECONDS=180

# AI 图片生成四级提供商链：Kuai、第二 OpenAI 兼容站、九野星霸 GPT Image 2、火山方舟。
# 各层使用独立 Provider 名称，单个站点熔断时不会误伤后续模型。
IMAGE_GENERATION_PROVIDER=kuai_openai_compatible
IMAGE_GENERATION_PROVIDER_CHAIN=kuai_openai_compatible,kuai_seedream_40,jiuye_image_2,volcengine_ark
IMAGE_GENERATION_BASE_URL=https://your-image-relay.example.com/v1
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=doubao-seedream-4-5-251128
IMAGE_GENERATION_EDIT_MODEL=doubao-seedream-4-5-251128
# 第二层默认与主层共用 Kuai 协议；密钥留空时按层级向前复用。
IMAGE_GENERATION_SECONDARY_BASE_URL=https://api.kuai.host/v1
IMAGE_GENERATION_SECONDARY_API_KEY=
IMAGE_GENERATION_SECONDARY_MODEL=doubao-seedream-4-0-250828
IMAGE_GENERATION_SECONDARY_EDIT_MODEL=doubao-seedream-4-0-250828
IMAGE_GENERATION_TERTIARY_BASE_URL=https://api.kuai.host/v1
IMAGE_GENERATION_TERTIARY_API_KEY=
IMAGE_GENERATION_TERTIARY_MODEL=doubao-seedream-4-0-250828
IMAGE_GENERATION_TERTIARY_EDIT_MODEL=doubao-seedream-4-0-250828
# 九野映像使用异步任务协议，作为第三层时必须由专用适配器提交并轮询。
IMAGE_GENERATION_JIUYE_BASE_URL=https://api.jiuyeyingxiang.com
IMAGE_GENERATION_JIUYE_API_KEY=
IMAGE_GENERATION_JIUYE_SUBMIT_PATH=/v1/xingba/image
IMAGE_GENERATION_JIUYE_POLL_PATH=/v1/xingba/image/{task_id}
IMAGE_GENERATION_JIUYE_MODEL=gpt-image-2
IMAGE_GENERATION_JIUYE_TIMEOUT_SECONDS=240
IMAGE_GENERATION_JIUYE_POLL_INTERVAL_SECONDS=3
# 开启后上一层图片提供商出现任意错误都会继续尝试下一层，全部失败才终止任务。
IMAGE_GENERATION_FALLBACK_ON_ANY_ERROR=true
# 火山方舟为第四层最终兜底，需配置独立密钥。
IMAGE_GENERATION_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_GENERATION_ARK_API_KEY=
IMAGE_GENERATION_ARK_MODEL=doubao-seedream-4-5-251128
IMAGE_GENERATION_TIMEOUT_SECONDS=240
IMAGE_GENERATION_PRIMARY_TIMEOUT_SECONDS=120
IMAGE_GENERATION_SECONDARY_TIMEOUT_SECONDS=150
IMAGE_GENERATION_TERTIARY_TIMEOUT_SECONDS=180
IMAGE_GENERATION_FALLBACK_PROVIDER=volcengine_ark
IMAGE_GENERATION_MAX_RESPONSE_BYTES=20971520

# 文章图片会自动叠加“当前产品名称 + 以下品牌联系方式”。
ARTICLE_IMAGE_BRAND_CONTACT=绣蔓家具TEL:18682130473

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9002
MINIO_PUBLIC_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wechat-assets
MINIO_USE_SSL=false
# 历史文章可能来自宿主机或迁移前地址；多个入口用逗号分隔。
MINIO_URL_ALIASES=http://localhost:9002,http://127.0.0.1:9002

# 腾讯 COS 私有图片临时中转。生产环境必须通过密钥管理服务注入凭证，禁止提交真实值。
COS_ENABLED=false
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=your-private-bucket-appid
# 可选的非签名可读基址；留空时不影响 SDK 按区域和桶生成签名 URL。
COS_ENDPOINT=https://your-private-bucket-appid.cos.ap-guangzhou.myqcloud.com
COS_SIGNED_URL_EXPIRE_SECONDS=3600

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
